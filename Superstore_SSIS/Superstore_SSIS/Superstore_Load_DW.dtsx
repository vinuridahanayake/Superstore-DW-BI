                  description="Specifies the SELECT statement used to create a schema rowset."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT [AlternateCustomerID], [City], [Country], [CustomerName], [PostalCode], [Region], [State],[StartDate],[EndDate] FROM [dbo].[DimCustomer]</property>
